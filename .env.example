NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Copy full HTTPS endpoint URLs and active per-catalog credentials from the
# eGov API Developer Portal. Never commit the populated values.
EGOV_AI_TOKEN_URL=https://platforms-api.e.gov.ph/egov-ai/api/v1/egov/integration/token
EGOV_AI_ASSISTANT_URL=https://platforms-api.e.gov.ph/egov-ai/api/v1/egov/integration/ai_assistant/generate
EGOV_AI_DOCUMENT_EXTRACTOR_URL=https://platforms-api.e.gov.ph/egov-ai/api/v1/egov/integration/document_extractor/generate
EGOV_AI_ACCESS_CODE=
EGOV_AI_ACCESS_TOKEN=

EGOVPAY_TRANSACTION_URL=https://platforms-api.e.gov.ph/egovpay/api/v1/transaction
EGOVPAY_API_TOKEN=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=
APP_BASE_URL=

EGOV_SSO_TOKEN_URL=https://platforms-api.e.gov.ph/egov-sso/api/token
EGOV_SSO_PROFILE_URL=https://platforms-api.e.gov.ph/egov-sso/api/partner/sso_authentication
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
# On (default): a spent or missing exchange code falls back to the stored eGov
# profile, so sign-in works without pasting a fresh code each time.
# Off: a valid, unused exchange code is required for every sign-in.
EGOV_SSO_ALLOW_STORED_FALLBACK=true

# AES-256-GCM key for encrypting PII in egov_sso_profiles. Generate with:
# openssl rand -base64 32
PII_ENCRYPTION_KEY=
EGOV_SSO_IMAGE_HOSTS=

EMESSAGE_ACCESS_TOKEN=
EMESSAGE_SMS_PUSH_URL=https://platforms-api.e.gov.ph/emessage/messaging/v1/sms/push
EMESSAGE_TEST_NUMBER=
